generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  profile       Profile?
  posts         Post[]
  role          Role      @default(USER)
  comments      Comment[]
  reviews       Review[]
  password      String
  emailVerified Boolean   @default(false)
  otp           String?
  otpExpiresAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
}

model Profile {
  id             String         @id @default(uuid())
  bio            String?
  phone          String?
  website        String?
  dateOfBirth    DateTime?
  address        String?
  bloodGroup     BloodGroup?
  gender         Gender?
  maritalStatus  MaritalStatus?
  about          String?
  user           User           @relation(fields: [userId], references: [id])
  userId         String         @unique
  coverPhoto     String?
  profilePicture String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  @@index([userId])
  @@map("profiles")
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

model Post {
  id         String      @id @default(uuid())
  title      String
  content    String?
  published  Boolean     @default(false)
  author     User        @relation(fields: [authorId], references: [id])
  authorId   String
  image      String?
  approved   Boolean     @default(false)
  slug       String      @unique
  isFeatured Boolean     @default(false)
  video      String?
  comments   Comment[]
  categories Category[]
  tags       String[]    @default([])
  reviews    Review[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  status     PostStatus?

  @@index([authorId])
  @@map("posts")
}

